NODE_ENV=

PORT=3000
APP_URL="http://127.0.0.1:3000"

ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=

SHOPIFY_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_STORE_FRONT_TOKEN=
SHOPIFY_API_VERSION=

AI_GATEWAY_API_KEY=
SUPERMEMORY_API_KEY=

# Redis connection URL (Upstash Redis: copy it from the dashboard, format rediss://default:PASSWORD@HOST:PORT)
REDIS_URL="rediss://default:password@localhost:6379"

QSTASH_URL="http://127.0.0.1:8080"
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

ALLOWED_PHONES=

# Auto-improve system prompt after negative feedback (OPTIONAL).
# If AUTO_IMPROVE_SYSTEM_PROMPT is not "true", this feature is disabled and the other variables are not required.
AUTO_IMPROVE_SYSTEM_PROMPT=false
# GitHub personal access token with "Contents" (read/write) and "Pull requests" (read/write) permissions for the repo.
GITHUB_TOKEN=
# Repository in the format "owner/repo", e.g. "my-organization/chatbot-shopify"
GITHUB_REPO=
# Base branch where the Pull Request will be opened (default is "main")
GITHUB_BASE_BRANCH=main
